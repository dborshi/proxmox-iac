log:
  level: INFO

accessLog:
  filePath: /var/log/traefik/access.log

api:
  dashboard: true

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"
  traefik:
    address: ":8080"

providers:
  file:
    filename: /etc/traefik/dynamic.yml
    watch: true

certificatesResolvers:
  cloudflare:
    acme:
      email: admin@{{ domain }}
      storage: /etc/traefik/acme.json
      dnsChallenge:
        provider: cloudflare