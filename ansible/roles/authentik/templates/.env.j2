# Managed by Ansible - do not edit manually
# Postgres
PG_PASS="{{ lookup('bitwarden.secrets.lookup', bw_authentik_db_password, base_url='https://vault.bitwarden.eu') }}"
PG_USER=authentik
PG_DB=authentik

# Authentik
AUTHENTIK_SECRET_KEY="{{ lookup('bitwarden.secrets.lookup', bw_authentik_secret_key, base_url='https://vault.bitwarden.eu') }}"
AUTHENTIK_POSTGRESQL__HOST={{ postgres_host }}

# Ports for the Authentik services
COMPOSE_PORT_HTTP=9000
COMPOSE_PORT_HTTPS=9443

# Increase the time between background maintenance checks (Default is often too low)
AUTHENTIK_WORKER__SCHEDULER_INTERVAL=hours=1

# Disable the auto-discovery of blueprints every few minutes
AUTHENTIK_BLUEPRINTS__DISCOVERY_INTERVAL=hours=24

# Reduce the frequency of outpost health/config checks
AUTHENTIK_OUTPOSTS__CONTROLLER_INTERVAL=minutes=30